{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug unit test",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "python": "${command:python.interpreterPath}",
            "args": [
                "tests.kurucz.test_spectrv"
            ],
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python: Unit Test Debug",
            "type": "debugpy",
            "request": "test",
            "console": "integratedTerminal",
            "redirectOutput": true,
            "python": "${command:python.interpreterPath}",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "(gdb) Debug BasicATLAS",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/dobos/project/BasicATLAS/bin/spectrv.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "/home/dobos/ATLAS_sun_model/synthe_1",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "sourceFileMap": {
                "/home/dobos/project/BasicATLAS": "/home/dobos/project/BasicATLAS/src"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Add source directory path for gdb",
                    "text": "directory /home/dobos/project/BasicATLAS/src",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
